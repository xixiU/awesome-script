{
  "manifest_version": 3,
  "name": "iFlytek Toolkit (讯飞工具箱)",
  "version": "3.2.0",
  "description": "讯飞全域工具箱：自动登录、解除复制限制(全域) + 21tb视频控制、自动答题、禁用切屏检测(开发测试)。xfchat.iflytek.com 下不生效",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.21tb.com/*",
    "*://*.iflytek.com/*",
    "*://*.iflytek.cn/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.21tb.com/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.21tb.com/*",
        "*://*.iflytek.com/*",
        "*://*.iflytek.cn/*"
      ],
      "exclude_matches": [
        "*://*.xfchat.iflytek.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}

